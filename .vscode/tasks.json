{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build OpenCV App",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++11",
                "-arch", "arm64",
                "${workspaceFolder}/main.cpp",
                "-I/opt/homebrew/include/opencv4",
                "-L/opt/homebrew/lib",
                "-lopencv_core",
                "-lopencv_imgcodecs",
                "-lopencv_highgui",
                "-lopencv_videoio",
                "-framework", "CoreFoundation",
                "-framework", "AudioToolbox",
                "-o", "${workspaceFolder}/app"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "type": "shell",
            "label": "Run OpenCV App",
            "command": "${workspaceFolder}/app",
            "dependsOn": "Build OpenCV App",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}

